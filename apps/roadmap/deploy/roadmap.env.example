# /etc/mvp/roadmap.env (chmod 600, owned by root): the roadmap's secrets, read by the systemd
# unit (docker run --env-file). Never commit the real one.

# Where browsers see it; GitHub sends them back to <this>/auth/callback.
ROADMAP_PUBLIC_URL=https://dev.mvpgg.com

# The GitHub OAuth App (github.com/settings/developers → OAuth Apps → "MVP Roadmap").
ROADMAP_GITHUB_CLIENT_ID=Ov23li…
ROADMAP_GITHUB_CLIENT_SECRET=…

# 32 random bytes in hex: `docker run --rm mvp-roadmap key`. A new key signs everyone out.
ROADMAP_SESSION_KEY=…

# Whose admins may sign in (default Filmoo/MVP).
#ROADMAP_REPO=Filmoo/MVP

# Set by the image (only change them to move things):
#ROADMAP_DB=/data/roadmap.db
#ROADMAP_BIND=0.0.0.0:8790
#ROADMAP_TRUST_PROXY=1
