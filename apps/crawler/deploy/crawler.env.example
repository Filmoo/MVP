# /etc/mvp/crawler.env (chmod 600, root only). Never commit the real file.
RIOT_API_KEY=RGAPI-replace-me
# Games fetched per cycle (a development key manages ~2k a day; a production key far more).
CRAWL_MAX_MATCHES=2000
# Only for the optional R2 mirror (rclone remote "r2" in /etc/mvp/rclone.conf).
R2_BUCKET=mvp-stats
