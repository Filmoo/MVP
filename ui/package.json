{
  "name": "@scout/ui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode app && node scripts/check-bundle.mjs",
    "build:preview": "vite build --outDir dist-preview",
    "preview": "vite preview --outDir dist-preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "screenshots": "playwright test --project=showcase"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.0",
    "solid-js": "1.9.15"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@playwright/test": "1.56.1",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vite-plugin-solid": "2.11.14",
    "vitest": "5.0.2",
    "@types/node": "26.6.3"
  }
}
